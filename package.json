{
  "name": "scentora-store",
  "version": "2.0.0",
  "description": "SCENTORA — full-stack perfume e-commerce platform (React storefront, COD checkout, admin dashboard) built with React, Vite, Node.js, Express and MongoDB.",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "dev": "concurrently -n server,client -c blue,magenta \"cross-env NODE_ENV=development node server/index.js\" \"npm --prefix client run dev\"",
    "dev:server": "cross-env NODE_ENV=development node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "seed": "node server/scripts/seed.js",
    "create-admin": "node server/scripts/create-admin.js",
    "test": "node --test server/tests/*.test.js"
  },
  "keywords": [
    "scentora",
    "perfume",
    "ecommerce",
    "cod",
    "react",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cloudinary": "2.11.0",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "express-validator": "7.3.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.12.3",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "nodemailer": "10.6.1"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "cross-env": "7.0.3"
  }
}
