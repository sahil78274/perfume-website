# ── SCENTORA environment configuration ─────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Node environment: development | production
NODE_ENV=development
# Port the HTTP server listens on
PORT=5000

# MongoDB connection string (required)
# Atlas example:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/scentora
# Local example:  mongodb://127.0.0.1:27017/scentora
MONGODB_URI=

# Secret used to sign customer & admin JWTs (required, min 32 chars)
# Generate with:  openssl rand -hex 48
JWT_SECRET=
# Optional token lifetimes (jsonwebtoken syntax)
JWT_CUSTOMER_TTL=7d
JWT_ADMIN_TTL=12h

# Cross-origin frontend. Production values must match the deployed storefront origin.
CORS_ORIGIN=https://scentora-store.onrender.com
CLIENT_URL=https://scentora-store.onrender.com

# First admin account — consumed by `npm run create-admin`
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Cloudinary (product photo uploads from the admin panel) ──
# Without these, image upload returns 503 but the rest of the app works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Outgoing email (order confirmations & admin notifications) ──
# Without these, orders still place fine; emails are skipped and logged.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Defaults to EMAIL_USER when empty
EMAIL_FROM=
# Optional — where new-order notifications are sent
ADMIN_NOTIFY_EMAIL=

# Production cookies are always Secure; this only opts in during development.
COOKIE_SECURE=
